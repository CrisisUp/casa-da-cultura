generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

enum StatusArtista {
  ATIVO
  INATIVO
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Artista {
  id                   String        @id @default(cuid())
  nome                 String
  cpf                  String        @unique
  rg                   String?
  telefone             String
  email                String?
  endereco             String?
  dataNascimento       DateTime?
  escolaridade         String?
  experienciaArtistica String?
  redesSociais         String?
  observacoes          String?
  generoArtistico      String
  foto                 String?
  status               StatusArtista @default(ATIVO)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([nome])
  @@index([generoArtistico])
  @@index([status])
  @@map("artistas")
}

model Depoimento {
  id        String   @id @default(cuid())
  nome      String
  genero    String
  texto     String
  avatar    String?
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo])
  @@index([ordem])
  @@map("depoimentos")
}
